# --- server ---
PORT=3001
HOST=0.0.0.0
VANE_DATA_DIR=./data            # sqlite file + settings.json live here
REDIS_URL=redis://127.0.0.1:6379
REDIS_DISABLED=0                # 1 = run without Redis (everything still works, just slower)
VANE_STATIC_DIR=web/out         # Next.js static export served by the Rust binary
RUST_LOG=info

# --- search providers (all optional; order per kind decides who is tried first) ---
SEARXNG_API_URL=http://127.0.0.1:8080
SEARXNG_USER=vane
SEARXNG_PASSWORD=
BRAVE_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
WEB_SEARCH_ORDER=brave,duckduckgo,searxng,html-scrape,exa,tavily,firecrawl
NEWS_SEARCH_ORDER=brave,duckduckgo,searxng,html-scrape,tavily
IMAGE_SEARCH_ORDER=searxng,brave,html-scrape,tavily
VIDEO_SEARCH_ORDER=searxng
WEB_SEARCH_NUM_RESULTS=20
SEARCH_CACHE_TTL=300            # seconds; Redis result cache

# --- model providers ---
OLLAMA_API_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- defaults (must be "providerId/modelName") ---
DEFAULT_MODEL=ollama/llama3.1:8b
DEFAULT_LIGHT_MODEL=ollama/llama3.1:8b
DEFAULT_RERANK_MODEL=ollama/llama3.1:8b
DEFAULT_EMBEDDING_MODEL=ollama/nomic-embed-text:latest
DEFAULT_IMAGE_MODEL=openai/dall-e-3

MAX_UPLOAD_MB=25
REQUEST_TIMEOUT_SECS=120
