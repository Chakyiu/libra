# --- server ---
PORT=3001
HOST=0.0.0.0
LIBRA_DATA_DIR=./data            # sqlite file + settings.json live here
REDIS_URL=redis://127.0.0.1:6379
REDIS_DISABLED=0                # 1 = run without Redis (everything still works, just slower)
LIBRA_STATIC_DIR=web/out         # Next.js static export served by the Rust binary
RUST_LOG=info

# --- access control ---
# Set a token and every /api request must carry `Authorization: Bearer <token>`; the UI asks
# for it once per browser and keeps it in localStorage. Empty = open API (LAN / behind a proxy only).
LIBRA_AUTH_TOKEN=
# Browser origins allowed to call /api cross-origin, comma separated. Empty = same-origin only,
# which is all the single-binary install needs (the Next dev server proxies /api server-side).
# `*` restores the wide-open development layer — do not run that on a public interface.
LIBRA_ALLOWED_ORIGINS=

# --- search providers (all optional; order per kind decides who is tried first) ---
SEARXNG_API_URL=http://127.0.0.1:8080
SEARXNG_USER=libra
SEARXNG_PASSWORD=
BRAVE_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
WEB_SEARCH_ORDER=brave,duckduckgo,searxng,html-scrape,exa,tavily,firecrawl
NEWS_SEARCH_ORDER=brave,duckduckgo,searxng,html-scrape,tavily
IMAGE_SEARCH_ORDER=searxng,brave,html-scrape,tavily
VIDEO_SEARCH_ORDER=searxng
WEB_SEARCH_NUM_RESULTS=20
SEARCH_CACHE_TTL=300            # seconds; Redis result cache

# --- page reading ---
# After search, Libra opens links in the question and the cited sources.
# Obscura (https://github.com/h4ckf0r0day/obscura) runs page scripts and, with a
# stealth build, fetches like a browser. The Docker image installs that binary.
# Without it, Libra falls back to a plain HTTP fetch of static HTML.
# OBSCURA_BIN=obscura             # name on PATH, or an absolute path
# OBSCURA_DISABLED=1              # do not open pages
# OBSCURA_STEALTH=0               # skip the browser TLS fingerprint
# FETCH_PAGE_LIMIT=5              # sources Balance reads; Fast reads fewer, Deep a few more
# FETCH_TIMEOUT_SECS=20           # per page

# --- automator (scheduled jobs) ---
# Jobs are stored in SQLite and fired by a sweep in the Libra process; microsandbox is the
# isolation layer, not the scheduler, so each command job starts one disposable microVM
# (msb run --name libra-<job> --replace --memory 256M --max-duration 5m -- <image> -- sh -lc '<cmd>').
# Install microsandbox on the machine serving Libra: curl -fsSL https://install.microsandbox.dev | sh
# MSB_BIN=msb                     # name on PATH, or an absolute path

# --- model providers ---
# None are configured by default. Add them (Ollama, OpenAI, OpenRouter, Anthropic, Gemini or any
# OpenAI-compatible server) in Settings → Model providers; they are stored in $LIBRA_DATA_DIR/settings.json.

MAX_UPLOAD_MB=25
REQUEST_TIMEOUT_SECS=120       # abort a provider call that sends no bytes for this long; a streaming answer may run longer
